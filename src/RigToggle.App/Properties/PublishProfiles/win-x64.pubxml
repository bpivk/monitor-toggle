<!--
  win-x64 self-contained single-file publish profile (PACKAGING-01).

  PublishTrimmed is explicitly false per CLAUDE.md: IL trimming's static reachability
  analysis frequently misidentifies COM-interop (IPolicyConfig audio) and P/Invoke
  marshalling (WindowsDisplayAPI CCD) code paths as unreachable and strips them, breaking
  those calls at runtime (05-RESEARCH.md Pitfall 3). false is already the SDK default, but
  it is set explicitly here to document intent and guard against a future accidental
  reintroduction (e.g. via an IDE "reduce size" suggestion).

  IncludeNativeLibrariesForSelfExtract=true bundles the .NET host's own native components
  into the single file so the publish output is a literal single .exe to copy, not the exe
  plus loose native host DLLs sitting next to it (05-RESEARCH.md Pitfall 2).

  RuntimeIdentifier is intentionally NOT set here — `dotnet publish` CLI does not honor
  RuntimeIdentifier when it is set only inside a .pubxml file (05-RESEARCH.md Pitfall 1).
  It lives in RigToggle.App.csproj's PropertyGroup instead.
-->
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <PublishDir>bin\publish\win-x64\</PublishDir>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>
</Project>
