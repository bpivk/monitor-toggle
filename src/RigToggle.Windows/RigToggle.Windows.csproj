<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Intentionally no elevation manifest element of any kind: this keeps the tool asInvoker
         (02-RESEARCH.md Pitfall 6) — do not add an elevated execution level or admin requirement. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WindowsDisplayAPI" Version="1.3.0.13" />
    <!-- This project's only NAudio usage is `using NAudio.CoreAudioApi;` in
         WindowsAudioController.cs; those types live in NAudio.Wasapi. The meta-package's
         WinMM/Midi/Asio/WinForms/Dmo backends were never used, so this swap requires zero
         source changes because the namespace is unchanged (18-RESEARCH.md). -->
    <PackageReference Include="NAudio.Wasapi" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RigToggle.Core\RigToggle.Core.csproj" />
  </ItemGroup>

</Project>
