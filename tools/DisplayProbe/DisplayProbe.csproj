<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- Standalone diagnostic tool, NOT part of RigToggle.sln / the shipped app.
         Deliberately not elevated (asInvoker) to match the real app's own execution context. -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="WindowsDisplayAPI" Version="1.3.0.13" />
  </ItemGroup>

</Project>
